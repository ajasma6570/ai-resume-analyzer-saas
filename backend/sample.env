# Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
RESUME_SERVICE_PORT=3003
ATS_SERVICE_PORT=3004

# Database URIs
AUTH_MONGO_URI=mongodb://127.0.0.1:27017/auth_db
RESUME_MONGO_URI=mongodb://127.0.0.1:27017/resume_db
ATS_MONGO_URI=mongodb://127.0.0.1:27017/ats

# API Keys (e.g., Gemini, OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JWT Config
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
