    "ats": "ts-node-dev --respawn -r tsconfig-paths/register src/services/ats-service/src/index.ts",
    "dev": "concurrently \"npm run gateway\" \"npm run auth\" \"npm run users\" \"npm run resume\" \"npm run ats\"",
    "build": "tsc && tsc-alias",
